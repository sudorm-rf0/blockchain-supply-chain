# syntax=docker/dockerfile:1

# ============ Builder ============
FROM node:20-alpine AS builder
WORKDIR /workspace

ARG ALPINE_MIRROR=https://dl-cdn.alpinelinux.org
# self-hosted macOS 上构建时可注入 HTTP_PROXY/HTTPS_PROXY 指向可用代理
ARG NEXT_PUBLIC_BACKEND_URL=https://supply-chain.example.com
ARG NEXT_PUBLIC_TRADE_API_URL=https://supply-chain.example.com
ARG NEXT_PUBLIC_POOL_API_URL=https://supply-chain.example.com
ARG NEXT_PUBLIC_INDEXER_API_URL=https://supply-chain.example.com
ARG NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
ARG NEXT_PUBLIC_CSP_REPORT_URI=
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ARG NPM_REGISTRY=
ARG NPM_FETCH_RETRIES=5
ENV NEXT_TELEMETRY_DISABLED=1
ENV npm_config_fetch_retries=${NPM_FETCH_RETRIES} \
    npm_config_fetch_timeout=120000 \
    npm_config_fetch_retry_mintimeout=10000 \
    npm_config_fetch_retry_maxtimeout=60000

RUN sed -i "s#https://dl-cdn.alpinelinux.org#${ALPINE_MIRROR}#g" /etc/apk/repositories \
    && apk add --no-cache libc6-compat openssl python3 make g++ \
    && corepack enable \
    && corepack prepare pnpm@9.4.0 --activate

COPY .npmrc package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/frontend/package.json packages/frontend/package.json
COPY packages/backend/package.json packages/backend/package.json
COPY packages/common/package.json packages/common/package.json

RUN if [ -n "${NPM_REGISTRY}" ]; then pnpm config set registry "${NPM_REGISTRY}"; fi \
    && pnpm install --frozen-lockfile

COPY packages/common packages/common
RUN pnpm --filter @supply-chain/common build
COPY packages/backend packages/backend
RUN pnpm --filter @supply-chain/backend exec prisma generate
RUN pnpm --filter @supply-chain/backend run build
RUN pnpm --filter @supply-chain/backend run build:indexer
RUN pnpm --filter @supply-chain/backend run build:trade
RUN pnpm --filter @supply-chain/backend run build:pool
RUN pnpm --filter @supply-chain/backend deploy --prod /app/backend-out

COPY packages/frontend packages/frontend
ENV NEXT_PUBLIC_BACKEND_URL=${NEXT_PUBLIC_BACKEND_URL}
ENV NEXT_PUBLIC_TRADE_API_URL=${NEXT_PUBLIC_TRADE_API_URL}
ENV NEXT_PUBLIC_POOL_API_URL=${NEXT_PUBLIC_POOL_API_URL}
ENV NEXT_PUBLIC_INDEXER_API_URL=${NEXT_PUBLIC_INDEXER_API_URL}
ENV NEXT_PUBLIC_RPC_URL=${NEXT_PUBLIC_RPC_URL}
ENV NEXT_PUBLIC_CSP_REPORT_URI=${NEXT_PUBLIC_CSP_REPORT_URI}
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=${NEXT_PUBLIC_TURNSTILE_SITE_KEY}
RUN mkdir -p packages/frontend/public
RUN pnpm --filter @supply-chain/frontend run build

# ============ Backend Runner ============
FROM node:20-alpine AS backend-runner
WORKDIR /app

ARG ALPINE_MIRROR=https://dl-cdn.alpinelinux.org
RUN sed -i "s#https://dl-cdn.alpinelinux.org#${ALPINE_MIRROR}#g" /etc/apk/repositories \
    && apk update \
    && apk add --no-cache libc6-compat openssl \
       tesseract-ocr poppler-utils \
    && (wget -q -O /usr/share/tessdata/chi_sim.traineddata \
          https://github.com/tesseract-ocr/tessdata/raw/main/chi_sim.traineddata \
        || wget -q -O /usr/share/tessdata/chi_sim.traineddata \
          https://raw.gitmirror.com/tesseract-ocr/tessdata/main/chi_sim.traineddata \
        || wget -q -O /usr/share/tessdata/chi_sim.traineddata \
          https://gitee.com/mirrors/tessdata/raw/main/chi_sim.traineddata) \
    && test -s /usr/share/tessdata/chi_sim.traineddata
ENV NODE_ENV=production PORT=3001 NODE_OPTIONS=--dns-result-order=ipv4first

COPY --from=builder /app/backend-out ./
COPY --from=builder /workspace/packages/backend/dist ./dist
COPY --from=builder /workspace/packages/backend/prisma ./prisma
RUN npx prisma generate

# 生成 Prisma Client（pnpm deploy 不会带 .prisma/client，运行时启动必需）
RUN ./node_modules/.bin/prisma generate --schema ./prisma/schema.prisma

RUN mkdir -p /app/uploads && chown -R node:node /app
RUN node -e "require('sharp')" || (echo "ERROR: sharp native module missing" && exit 1)
USER node
EXPOSE 3001
CMD ["node", "dist/src/main.js"]

# ============ Frontend Runner ============
FROM node:20-alpine AS frontend-runner
WORKDIR /app

ARG ALPINE_MIRROR=https://dl-cdn.alpinelinux.org
RUN sed -i "s#https://dl-cdn.alpinelinux.org#${ALPINE_MIRROR}#g" /etc/apk/repositories \
    && apk add --no-cache libc6-compat
ENV NODE_ENV=production PORT=3000

COPY --from=builder /workspace/packages/frontend/.next/standalone ./
COPY --from=builder /workspace/packages/frontend/.next/static ./packages/frontend/.next/static
COPY --from=builder /workspace/packages/frontend/public ./packages/frontend/public

USER node
EXPOSE 3000
CMD ["node", "packages/frontend/server.js"]
