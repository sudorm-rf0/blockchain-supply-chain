# 外部出口 CIDR 模板：生成 k8s/network-policies.generated.yaml（gitignored）。
# 未配置的用途会回退到 0.0.0.0/0（宽放）；建议上线前全部收紧密级。
#
# Solana RPC（Helius/QuickNode 等）。查询实际出口 IP：
#   curl -s https://api.ipify.org 或供应商文档给出的 IP 段
SOLANA_RPC_CIDR=
#
# 风控 Webhook（违约通知接收服务）出口 IP/段
RISK_WEBHOOK_CIDR=
#
# 对象存储（AWS S3 / 阿里云 OSS / MinIO）出口 IP/段
S3_CIDR=
