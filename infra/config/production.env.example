# 生产环境变量模板：复制为 production.env，逐项填写，不要提交真实凭据。
# 各服务启动/部署时通过环境变量或 K8s Secret 注入。

# ---------- 通用 ----------
NODE_ENV=production
JWT_SECRET=
ALLOWED_ORIGIN=https://your-domain
THROTTLE_LIMIT=120
PORT=3001
APP_VERSION=1.0.0

# ---------- 数据库 / Redis ----------
DATABASE_URL=postgresql://user:pass@postgres:5432/supply_chain?connection_limit=10&pool_timeout=20&socket_timeout=30&schema=public
REDIS_URL=redis://redis:6379

# ---------- Solana（主网） ----------
# 真实上线必须填主网 RPC（Helius/QuickNode 付费档）；支持逗号分隔多 Key 轮询分摊配额。
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_KEYPAIR_PATH=/app/.config/solana/id.json
TRADE_FINANCE_PROGRAM_ID=            # 部署后用 deploy-mainnet.sh 输出的新 ID 回填
SUPPLY_CHAIN_PROGRAM_ID=
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v   # 主网 USDC
LP_MINT=                             # 新建（mint authority 交多签）
POOL_STATE_ADDRESS=

# ---------- 主网合约部署（scripts/deploy-mainnet.sh 使用） ----------
# DEPLOY_WALLET=                        # 独立冷钱包地址
# TRADE_KEYPAIR=packages/contracts/target/deploy/mainnet/trade_finance-keypair.json
# SUPPLY_KEYPAIR=packages/contracts/target/deploy/mainnet/supply_chain-keypair.json
# MIN_BALANCE_SOL=2
# EXPECT_POOL=absent

# ---------- 文件存储 ----------
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ---------- 安全 ----------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# 或 SCAN_URL=https://scan.example.com/check
SCAN_URL=
ALLOW_UNSCANNED_UPLOADS=false
WEBHOOK_SECRET=
MAX_UPLOADS_PER_DAY=200
AUDIT_RETENTION_DAYS=90

# ---------- 业务 Webhook ----------
RISK_WEBHOOK_URL=
REPAYMENT_NOTIFY_URL=
WEBHOOK_RETRY_DELAY_MS=5000

# ---------- 可观测性 ----------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------- 前端构建期变量（镜像构建时传入） ----------
NEXT_PUBLIC_BACKEND_URL=https://your-domain
NEXT_PUBLIC_TRADE_API_URL=https://your-domain
NEXT_PUBLIC_POOL_API_URL=https://your-domain
NEXT_PUBLIC_INDEXER_API_URL=https://your-domain
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_CSP_REPORT_URI=

# ---------- Alertmanager 告警渠道（deploy.sh 使用） ----------
ALERTMANAGER_WEBHOOK_URL=
ALERTMANAGER_SLACK_URL=
ALERTMANAGER_SLACK_CHANNEL=#alerts
ALERTMANAGER_EMAIL_TO=
ALERTMANAGER_SMTP_SMARTHOST=
ALERTMANAGER_SMTP_FROM=

# ---------- 管理种子（首次部署后请立即修改默认管理员密码） ----------
ADMIN_EMAIL=admin@supply-chain.io
ADMIN_PASSWORD=Admin123!

# ---- 审计治理前置（DFR-0148 无保留通过所需）----
# UPGRADE_AUTHORITY_PLAN=cold-wallet   # cold-wallet | freeze，需公开处置计划
# MULTISIG_ADMIN=                      # Squads 多签 PDA（资金池/注册中心 admin，建议 >=3/5）
# INITIAL_ADMIN_DELAY=172800           # 初始化时锁下限（秒，>=86400）
