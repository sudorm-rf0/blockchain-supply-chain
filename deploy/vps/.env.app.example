# ================= VPS-A（应用机）环境变量 =================
# 复制为 .env.app 并修改。部署脚本 scripts/deploy-vps.sh 会加载它。

# --- 域名 / 前端（NEXT_PUBLIC_* 是构建期变量，改域名必须重新构建镜像）---
PUBLIC_BASE_URL=https://supply-chain.example.com
NEXT_PUBLIC_BACKEND_URL=https://supply-chain.example.com
NEXT_PUBLIC_TRADE_API_URL=https://supply-chain.example.com
NEXT_PUBLIC_POOL_API_URL=https://supply-chain.example.com
NEXT_PUBLIC_INDEXER_API_URL=https://supply-chain.example.com
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CSP_REPORT_URI=

# --- 数据库 / Redis（VPS-B 的内网 IP；Redis 带密码时用 redis://:<pwd>@<ip>:6379）---
DATABASE_URL=postgresql://supply:CHANGE_ME@10.0.0.2:5432/supply_chain?connection_limit=10&pool_timeout=20&socket_timeout=30&schema=public
REDIS_URL=redis://:CHANGE_ME@10.0.0.2:6379

# --- 链（正式环境用主网值；devnet 用 api.devnet.solana.com + devnet 测试 Mint）---
SOLANA_RPC_URL=https://api.devnet.solana.com   # 支持逗号分隔多个 Key 轮询
TRADE_FINANCE_PROGRAM_ID=9c8eND94LxNZgDbhvApGsRKojHyxhgEVUBSUHU9tRVU3
SUPPLY_CHAIN_PROGRAM_ID=Dcxixk89HPaC6yHKk1rP5HGMFgBMcRrYku6ze951C6Lk
USDC_MINT=CHANGE_ME
LP_MINT=CHANGE_ME
POOL_STATE_ADDRESS=

# --- 安全 ---
JWT_SECRET=CHANGE_ME__openssl_rand_hex_32
ALLOWED_ORIGIN=https://supply-chain.example.com
WEBHOOK_SECRET=CHANGE_ME__openssl_rand_hex_32   # >= 32 字符，生产强制
ADMIN_PASSWORD=CHANGE_ME__strong_admin_password
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- 存储（local=应用机磁盘；s3=对象存储，配合 AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY）---
STORAGE_DRIVER=local
# S3_BUCKET=supply-chain-files
# S3_REGION=us-east-1
# S3_ENDPOINT=https://minio.10.0.0.2:9000
# S3_FORCE_PATH_STYLE=true

# --- 其他（按需）---
THROTTLE_LIMIT=120
MAX_UPLOADS_PER_DAY=200
AUDIT_RETENTION_DAYS=90
RISK_WEBHOOK_URL=
REPAYMENT_NOTIFY_URL=
SENTRY_DSN=
