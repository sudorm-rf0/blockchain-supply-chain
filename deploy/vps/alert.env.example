# 邮件告警 SMTP 配置（VPS 上实际位置：/etc/supply-chain-alert.env，权限 600）
# 以 139 邮箱为例：需先在网页版邮箱开启 SMTP 服务并获取授权码
SMTP_HOST=smtp.139.com
SMTP_PORT=465            # 465=SSL；587=STARTTLS
SMTP_USER=发件邮箱@139.com
SMTP_PASS=SMTP授权码
SMTP_FROM=供应链系统告警
ALERT_RECIPIENT=14777904019@139.com

# Cloudflare 告警 Webhook 校验密钥（与 Cloudflare 控制台/API 创建 webhook 时填写的 secret 一致）
CF_WEBHOOK_SECRET=CHANGE_ME_RANDOM_STRING
