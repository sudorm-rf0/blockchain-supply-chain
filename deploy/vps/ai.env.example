# AI 运维自愈代理配置（复制为 /etc/supply-chain-ai.env）
# 默认全部关闭：不填 AI_API_KEY 时只做确定性自愈（fail2ban/CF 规则），不调用任何 LLM
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 1=启用 LLM 诊断（需 AI_API_KEY）；0/空=关闭
AI_AGENT_ENABLED=0
# 1=允许 AI 自动重启 supply-chain 应用容器；0=只报告需人工
AI_AUTO_RESTART=0
# 自动动手的最低严重度：critical=只处理严重问题（站点/核心服务/磁盘将满/安全防线）；warning/info=仅诊断
AI_ACT_SEVERITY=critical
# 1=只记录不执行（演练用）
AI_DRY_RUN=0
# 同一问题两次 AI 处理的最小间隔（秒）
AI_COOLDOWN=1800
# LLM 调用超时（秒）
AI_TIMEOUT=45
