DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supply_chain?connection_limit=10&pool_timeout=20&socket_timeout=30&schema=public"
REDIS_URL="redis://localhost:6380"
SOLANA_RPC_URL="http://localhost:8899"
# 生产：SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
#       （密钥放入 infra/config/rpc.devnet.env，勿提交 Git）
PORT=3001
# JWT_SECRET 必须设置且 >= 32 字符（所有环境强制）；用 openssl rand -hex 32 生成
JWT_SECRET=""
THROTTLE_LIMIT=120
# 压测/CI 可调大：THROTTLE_LIMIT=100000
MAX_UPLOADS_PER_DAY=200
ALLOWED_ORIGIN=""

# 病毒扫描：优先 CLAMAV_HOST（clamd TCP），否则 SCAN_URL（HTTP JSON {clean:boolean}）；
# 都未配置时跳过扫描。生产环境必须启用其一。
CLAMAV_HOST=""
CLAMAV_PORT=3310
SCAN_URL=""
AUDIT_RETENTION_DAYS=90
# 前端 CSP 违规上报地址（可选）：NEXT_PUBLIC_CSP_REPORT_URI=http://localhost:3001/api/csp-report

# 文件存储：local 或 s3
STORAGE_DRIVER="local"
S3_BUCKET="supply-chain-files"
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# indexer-service
TRADE_FINANCE_PROGRAM_ID="9c8eND94LxNZgDbhvApGsRKojHyxhgEVUBSUHU9tRVU3"
POOL_STATE_ADDRESS=""
RISK_WEBHOOK_URL="http://localhost:8080/risk/defaulted"
SYNC_QUEUE_NAME="sync-queue"
INDEXER_PORT=3003
