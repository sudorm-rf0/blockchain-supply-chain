generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum DealStatus {
  PENDING
  FUNDED
  IN_TRANSIT
  CUSTOMS_CLEAR
  DELIVERED
  REPAYING
  SETTLED
  DEFAULTED
}

model User {
  id                   String    @id @default(cuid())
  wallet               String    @unique
  email                String?   @unique
  passwordHash         String?
  name                 String?
  role                 String    @default("USER")
  mustChangePassword   Boolean   @default(false)
  lastPasswordChangeAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  buyerDeals    TradeDeal[]   @relation("Buyer")
  sellerDeals   TradeDeal[]   @relation("Seller")
  files         File[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id                  String   @id @default(cuid())
  tokenHash           String   @unique
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  revokedAt           DateTime?
  replacedByTokenHash String?

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TradeDeal {
  id                   String     @id
  dealId               String     @unique
  buyerId              String?
  sellerId             String?
  buyerWallet          String
  sellerWallet         String
  amount               BigInt
  downPayment          BigInt
  poolPortion          BigInt
  tenor                BigInt
  status               DealStatus @default(PENDING)
  createdAt            DateTime
  repaidAt             DateTime?
  txSignature          String?
  logisticsHash        String?
  defaultWebhookSentAt DateTime?
  rawData              Json?
  updatedAt            DateTime   @updatedAt

  buyer  User? @relation("Buyer", fields: [buyerId], references: [id])
  seller User? @relation("Seller", fields: [sellerId], references: [id])

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([buyerWallet])
  @@index([createdAt])
}

model PoolSnapshot {
  id               String   @id @default(cuid())
  poolAddress      String
  nav              BigInt
  utilization      BigInt
  totalAssets      BigInt
  activeCapital    BigInt
  reserveFund      BigInt
  insuranceFund    BigInt
  pendingDividends BigInt
  capturedAt       DateTime

  @@unique([poolAddress, capturedAt])
  @@index([poolAddress, capturedAt])
}

enum WithdrawStatus {
  PENDING
  READY
  EXECUTED
}

model WithdrawRequest {
  id          String         @id @default(cuid())
  lpAddress   String
  amount      Decimal        @db.Decimal(18, 6)
  requestedAt DateTime
  availableAt DateTime
  status      WithdrawStatus @default(PENDING)

  @@index([lpAddress, status])
  @@index([requestedAt])
  @@map("withdraw_requests")
}

enum FileStatus {
  PENDING
  APPROVED
  REJECTED
}

model File {
  id               String     @id @default(cuid())
  filename         String
  size             Int
  mimeType         String
  path             String
  hash             String
  txSignature      String?
  documentPda      String?
  attestedAt       DateTime?
  status           FileStatus @default(PENDING)
  tradeId          String?
  documentGroupId  String?
  version          Int        @default(1)
  supersededAt     DateTime?
  description      String?
  remark           String?
  uploaderId       String?
  uploader         User?      @relation(fields: [uploaderId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([tradeId])
  @@index([documentGroupId])
  @@index([tradeId, documentGroupId])
  @@map("files")
}

model Supplier {
  id           String    @id @default(cuid())
  address      String    @unique
  pda          String    @unique
  authorizedAt DateTime
  revokedAt    DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([revokedAt])
  @@map("supply_chain_suppliers")
}

model Product {
  id          String   @id @default(cuid())
  owner       String
  sku         String
  units       BigInt
  pda         String   @unique
  txSignature String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([owner, sku])
  @@index([owner])
  @@map("supply_chain_products")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
