generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum DealStatus {
  PENDING
  FUNDED
  IN_TRANSIT
  CUSTOMS_CLEAR
  DELIVERED
  REPAYING
  SETTLED
  DEFAULTED
}

model User {
  id                   String    @id @default(cuid())
  wallet               String    @unique
  email                String?   @unique
  passwordHash         String?
  name                 String?
  role                 String    @default("USER")
  mustChangePassword   Boolean   @default(false)
  lastPasswordChangeAt DateTime?
  totpSecret           String?
  totpEnabled          Boolean   @default(false)
  /// 登录邮箱验证码二次验证（Email OTP，可与 TOTP 并存）。
  /// 最高安全策略：真实账号强制开启（默认 true，不可关闭）；
  /// 仅种子管理员（本地演示/CI 引导）显式设为 false 以便直接登录。
  emailOtpEnabled      Boolean   @default(true)
  /// 注册邮箱是否已验证（防垃圾注册：验证通过前账号不可登录）
  emailVerified        Boolean   @default(false)
  emailVerifiedAt      DateTime?
  /// 账号注销时间（软删除：注销后禁止登录，保留数据完整性）
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  /// 注册时使用的邀请码
  inviteCodeId String?      @unique
  inviteCode   InviteCode?  @relation("InviteCodeUser", fields: [inviteCodeId], references: [id])

  buyerDeals    TradeDeal[]   @relation("Buyer")
  sellerDeals   TradeDeal[]   @relation("Seller")
  files         File[]
  financingRequests         FinancingRequest[]  @relation("FinancingApplicant")
  reviewedFinancingRequests FinancingRequest[]  @relation("FinancingReviewer")
  refreshTokens RefreshToken[]
  notifications Notification[]
  notificationReads NotificationRead[]
  createdNotifications Notification[] @relation("NotificationCreator")
  apiKeys       ApiKey[]
  webhooks      Webhook[]
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  /// 生成该邀请码的管理员（超管 id，仅展示用）
  createdById String?
  /// 使用该邀请码注册的用户（一个码仅能被一个用户使用）
  usedById    String?   @unique
  usedBy      User?     @relation("InviteCodeUser")
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById])
  @@map("invite_codes")
}

model RefreshToken {
  id                  String   @id @default(cuid())
  tokenHash           String   @unique
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  revokedAt           DateTime?
  replacedByTokenHash String?

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TradeDeal {
  id                   String     @id
  dealId               String     @unique
  buyerId              String?
  sellerId             String?
  buyerWallet          String
  sellerWallet         String
  amount               BigInt
  downPayment          BigInt
  poolPortion          BigInt
  tenor                BigInt      /// 账期，单位秒
  status               DealStatus @default(PENDING)
  createdAt            DateTime
  repaidAt             DateTime?
  txSignature          String?
  logisticsHash        String?
  name                 String?
  remark               String?
  defaultWebhookSentAt DateTime?
  rawData              Json?
  updatedAt            DateTime   @updatedAt

  buyer  User? @relation("Buyer", fields: [buyerId], references: [id])
  seller User? @relation("Seller", fields: [sellerId], references: [id])

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([buyerWallet])
  @@index([createdAt])
}

model PoolSnapshot {
  id               String   @id @default(cuid())
  poolAddress      String
  nav              BigInt
  utilization      BigInt
  totalAssets      BigInt
  activeCapital    BigInt
  reserveFund      BigInt
  insuranceFund    BigInt
  pendingDividends BigInt
  /// 资金池紧急暂停开关（合约 PoolState.paused）。
  paused           Boolean @default(false)
  /// 在途托管垫付（审计 M-01）。
  escrowFunded     BigInt @default(0)
  /// 当前赎回单价（审计 M-04）。
  redemptionPrice  BigInt @default(0)
  /// 赎回窗口起始纪元（审计 M-05）。
  redeemWindowEpoch BigInt @default(0)
  /// 赎回窗口已用额度（审计 M-05）。
  redeemWindowUsed BigInt @default(0)
  /// 待确认的新管理员（两步转移 H-03）；无待转移时为空。
  pendingAdmin     String?
  pendingAdminProposedAt BigInt @default(0)
  /// H-04 年化费率（bps）。
  feeApyBps        BigInt @default(0)
  /// H-04 费用分成：LP / 平台 / 返利（bps）。
  lpShareBps       BigInt @default(0)
  platformShareBps BigInt @default(0)
  rebateShareBps   BigInt @default(0)
  /// 首损准备金（H-04 first-loss tranche）。
  firstLossReserve BigInt @default(0)
  /// 保险基金最低余额阈值。
  minInsuranceAbs  BigInt @default(0)
  /// 逾期费率（bps）。
  overdueFeeApyBps BigInt @default(0)
  /// 两步转移延迟（秒）。
  pendingAdminDelaySecs BigInt @default(0)
  capturedAt       DateTime

  @@unique([poolAddress, capturedAt])
  @@index([poolAddress, capturedAt])
}

enum WithdrawStatus {
  PENDING
  READY
  EXECUTED
}

model WithdrawRequest {
  id          String         @id @default(cuid())
  lpAddress   String
  amount      Decimal        @db.Decimal(18, 6)
  requestedAt DateTime
  availableAt DateTime
  status      WithdrawStatus @default(PENDING)

  @@index([lpAddress, status])
  @@index([requestedAt])
  @@map("withdraw_requests")
}

enum FileStatus {
  PENDING
  APPROVED
  REJECTED
}

model File {
  id               String     @id @default(cuid())
  filename         String
  size             Int
  mimeType         String
  path             String
  hash             String
  txSignature      String?
  documentPda      String?
  attestedAt       DateTime?
  status           FileStatus @default(PENDING)
  tradeId          String?
  documentGroupId  String?
  version          Int        @default(1)
  supersededAt     DateTime?
  description      String?
  remark           String?
  region           String?
  ocrStatus        String         @default("PENDING")
  ocrText          String?
  ocrLang          String?
  authStatus       String         @default("PENDING")
  authScore        Int?
  authResult       Json?
  analyzedAt       DateTime?
  translations     Json?
  uploaderId       String?
  uploader         User?      @relation(fields: [uploaderId], references: [id])
  financingRequests FinancingRequest[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([tradeId])
  @@index([documentGroupId])
  @@index([tradeId, documentGroupId])
  @@map("files")
}

model Supplier {
  id           String    @id @default(cuid())
  address      String    @unique
  pda          String    @unique
  authorizedAt DateTime
  revokedAt    DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([revokedAt])
  @@map("supply_chain_suppliers")
}

model Product {
  id          String   @id @default(cuid())
  owner       String
  sku         String
  units       BigInt
  pda         String   @unique
  txSignature String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([owner, sku])
  @@index([owner])
  @@map("supply_chain_products")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}


model FinancingRequest {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      File     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  applicantId  String
  applicant    User     @relation("FinancingApplicant", fields: [applicantId], references: [id])
  invoiceAmount BigInt
  amount       BigInt
  discountRate Int
  tenorDays    Int
  status       String   @default("PENDING")
  reviewedById String?
  reviewedBy   User?    @relation("FinancingReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  repaidAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([applicantId])
  @@index([invoiceId])
  @@map("financing_requests")
}

model Notification {
  id        String   @id @default(cuid())
  /// 定向通知的用户；全站通知（broadcast=true）为 null
  userId    String?
  /// 通知类型：FILE_REVIEWED / TRADE_STATUS / WITHDRAWAL_STATUS / SYSTEM / BROADCAST
  type      String
  title     String
  body      String?
  metadata  Json?
  /// 全站通知标志：true 时对所有用户可见
  broadcast Boolean  @default(false)
  /// 全站通知发布者（留痕）
  creatorId String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator User? @relation("NotificationCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  reads NotificationRead[]

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([broadcast, createdAt])
  @@map("notifications")
}

/// 全站通知的按用户已读记录
model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_reads")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  /// sha256(原始 Key)，原始 Key 仅在创建时返回一次
  keyHash    String    @unique
  /// 展示用前缀（原始 Key 前 8 位）
  prefix     String
  role       String    @default("USER")
  userId     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Webhook {
  id         String    @id @default(cuid())
  name       String
  url        String
  /// 请求签名密钥（sha256），用于校验请求来自系统
  secretHash String?
  events     Json
  active     Boolean   @default(true)
  userId     String
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhooks")
}
