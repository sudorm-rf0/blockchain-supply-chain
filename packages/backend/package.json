{
  "name": "@supply-chain/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "dev:indexer": "tsc -p apps/indexer-service/tsconfig.app.json --watch --preserveWatchOutput",
    "build:indexer": "tsc -p apps/indexer-service/tsconfig.app.json",
    "start:indexer": "node dist/apps/indexer-service/src/main.js",
    "dev:trade": "tsc -p apps/trade-service/tsconfig.app.json --watch --preserveWatchOutput",
    "build:trade": "tsc -p apps/trade-service/tsconfig.app.json",
    "start:trade": "node dist/apps/trade-service/src/main.js",
    "dev:pool": "tsc -p apps/pool-service/tsconfig.app.json --watch --preserveWatchOutput",
    "build:pool": "tsc -p apps/pool-service/tsconfig.app.json",
    "start:pool": "node dist/apps/pool-service/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.9",
    "@nestjs/core": "^10.3.9",
    "@nestjs/platform-express": "^10.3.9",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.15.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.91.3",
    "bullmq": "^5.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "multer": "^2.2.0",
    "prisma": "^5.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.2",
    "@nestjs/testing": "^10.3.9",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
