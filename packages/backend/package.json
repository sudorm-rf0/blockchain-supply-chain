{
  "name": "@supply-chain/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "dev:indexer": "tsc -p apps/indexer-service/tsconfig.app.json --watch --preserveWatchOutput",
    "build:indexer": "tsc -p apps/indexer-service/tsconfig.app.json",
    "start:indexer": "node dist/apps/indexer-service/apps/indexer-service/src/main.js",
    "dev:trade": "tsc -p apps/trade-service/tsconfig.app.json --watch --preserveWatchOutput",
    "build:trade": "tsc -p apps/trade-service/tsconfig.app.json",
    "start:trade": "node dist/apps/trade-service/apps/trade-service/src/main.js",
    "dev:pool": "tsc -p apps/pool-service/tsconfig.app.json --watch --preserveWatchOutput",
    "build:pool": "tsc -p apps/pool-service/tsconfig.app.json",
    "start:pool": "node dist/apps/pool-service/apps/pool-service/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"apps/**/src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"apps/**/src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.69.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.98.4",
    "bullmq": "^5.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "multer": "^2.2.0",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.66.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
