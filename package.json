{
  "name": "blockchain-supply-chain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.1.0",
      "body-parser": "^1.20.6",
      "path-to-regexp": "^3.3.0",
      "lodash": "^4.18.0",
      "js-yaml": "^4.3.0",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "keygen": "node scripts/keygen.cjs",
    "setup": "bash ./init-monorepo.sh",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.98.4",
    "@types/express": "^5.0.6",
    "turbo": "^2.0.3",
    "typescript": "^5.5.3"
  }
}
