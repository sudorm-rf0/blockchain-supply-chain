{
  "name": "blockchain-supply-chain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.1.0",
      "lodash": "^4.18.0",
      "js-yaml": "^4.3.1",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "qs": "^6.15.2",
      "uuid": "^11.1.1",
      "file-type": "21.3.2",
      "serialize-javascript": "^7.0.7",
      "diff": "^8.0.3"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "keygen": "node scripts/keygen.cjs",
    "setup": "bash ./init-monorepo.sh",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "health": "bash scripts/health-check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.98.4",
    "@sqds/multisig": "2.1.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.0.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.66.0"
  },
  "description": "Solana blockchain supply chain finance monorepo (contracts / backend / frontend)"
}